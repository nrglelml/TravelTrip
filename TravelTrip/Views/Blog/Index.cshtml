@model TravelTrip.Models.Siniflar.BlogYorum
@using TravelTrip.Helper
@{
    ViewBag.Title = "Blog";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content">
    <div class="wrap">
        <div class="blog-layout">
            <div class="blog-main">
                @foreach (var i in Model.Deger1)
                {
                    <article class="blog-post-card">
                        <div class="blog-post-img">
                            <a href="/Blog/BlogDetay/@i.ID">
                                <img src="@Url.Content(i.BlogImage)" alt="@i.Baslik" />
                            </a>
                        </div>
                        <div class="blog-post-body">
                            <h2 class="blog-post-title">
                                <a href="/Blog/BlogDetay/@i.ID">@i.Baslik</a>
                            </h2>
                            <p class="blog-post-excerpt">
                                @i.Aciklama.KelimeBolmedenKisalt(200)...
                                <a href="/Blog/BlogDetay/@i.ID" class="read-more-link">Devamını Oku →</a>
                            </p>
                        </div>
                    </article>
                }
            </div>
            <aside class="blog-sidebar">
                @Html.Action("Partial1", "Blog")
                @Html.Action("Partial2", "Blog")
            </aside>

        </div>
    </div>
</div>
