@model TravelTrip.Models.Siniflar.BlogYorum
@{
    ViewBag.Title = "Blog Detay";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content">
    <div class="wrap">
        <div class="blog-layout">
            <div class="blog-main">
                @foreach (var i in Model.Deger1)
                {
                    <article class="blog-detail-article">
                        <div class="blog-detail-img">
                            <img src="@i.BlogImage" alt="@i.Baslik" />
                        </div>
                        <h1 class="blog-detail-title">@i.Baslik</h1>
                        <div class="blog-detail-content">
                            <p>@i.Aciklama</p>
                        </div>
                    </article>
                }
                <div class="comments-section">
                    <h3 class="comments-heading">Yorumlar</h3>

                    @if (!Model.Deger2.Any())
                    {
                        <div class="comments-empty">
                            <p>Henüz yorum yapılmamış. İlk yorumu siz yapın!</p>
                        </div>
                    }
                    else
                    {
                        foreach (var i in Model.Deger2)
                        {
                            <div class="comment-item">
                                <div class="comment-avatar">
                                    <span>@i.KullaniciAdi.Substring(0, 1).ToUpper()</span>
                                </div>
                                <div class="comment-body">
                                    <div class="comment-meta">
                                        <strong>@i.KullaniciAdi</strong>
                                        <span class="comment-email">@i.Mail</span>
                                    </div>
                                    <p class="comment-text">@i.Yorum</p>
                                </div>
                            </div>
                        }
                    }
                    <div class="comment-form-section">
                        @Html.Action("YorumYap", "Blog")
                    </div>
                </div>

            </div>
            <aside class="blog-sidebar">
                @Html.Action("Partial1", "Blog")
                @Html.Action("Partial2", "Blog")
            </aside>

        </div>
    </div>
</div>
