@model TravelTrip.Models.Siniflar.Yorumlar
@{
    ViewBag.Title = "BlogGetir";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Yorum Güncelleme Sayfası</h2>

<div class="card p-4 shadow-sm">
    @using (Html.BeginForm("YorumGuncelle", "Admin", FormMethod.Post))
    {
        <div class="mb-3">
            @Html.LabelFor(x => x.ID, "Yorum ID")
            @Html.TextBoxFor(x => x.ID, new { @class = "form-control", @readonly = "readonly" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(x => x.KullaniciAdi, "Kullanıcı Adı")
            @Html.TextBoxFor(x => x.KullaniciAdi, new { @class = "form-control" })

        </div>
        <div class="mb-3">
            @Html.LabelFor(x => x.Mail, "Mail")
            @Html.TextBoxFor(x => x.Mail, new { @class = "form-control" })

        </div>

        <div class="mb-3">
            @Html.LabelFor(x => x.Yorum, "Yorum")
            @Html.TextAreaFor(x => x.Yorum, new { @class = "form-control", @rows = "5" })

        </div>


        <button class="btn btn-outline-success w-100 py-2">
            <i class="fas fa-save"></i> Yorumu Güncelle
        </button>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


@if (ViewBag.Basarili == true)
{
    <script>
        Swal.fire({
            title: 'Başarılı!',
            text: 'Yorum güncellendi, listeye yönlendiriliyorsunuz.',
            icon: 'success',
            confirmButtonText: 'Tamam',
            confirmButtonColor: '#009688'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '@Url.Action("YorumListesi", "Admin")';
            }
        })
    </script>
}