@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>_AdminLayout</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/adminStyle.css" />
</head>
<body>
    <div class="d-flex" style="min-height: 100vh;">
        <div class="d-flex flex-column flex-shrink-0 p-3 bg-light border-end" style="width: 280px;">
            <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto link-dark text-decoration-none">
                <span class="fs-4 fw-bold">Admin Yönetim Paneli</span>
            </a>
            <hr>                                                                                                            
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a href="/Admin/Index" class="nav-link active">Bloglar</a>
                </li>
                <li><a href="/Admin/YorumListesi" class="nav-link link-dark">Yorumlar</a></li>
                <li><a href="/Admin/Contact" class="nav-link link-dark">İletişim</a></li>
                <li><a href="/Admin/Hakkimizda" class="nav-link link-dark">Hakkımızda</a></li>
                <li><a href="/Home/Index" class="nav-link link-dark">Ana Sayfaya Git</a></li>

            </ul>

            <div class="mt-auto">
                <a href="/Login/LogOut" class="btn btn-danger w-100 py-2 fw-bold shadow-sm">
                    Çıkış Yap
                </a>
            </div>

        </div>

        <div class="flex-grow-1">
            <div style="background-color: #f598b8; color: white; padding: 20px 40px; margin-bottom: 20px; ">
                <h1 style="margin: 0; font-size: 36px; font-weight: 400;">@Session["Kullanici"]</h1>
            </div>

            <div class="p-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/AdminJS.js"></script>
</body>
</html>