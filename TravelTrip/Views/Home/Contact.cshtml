@model TravelTrip.Models.Siniflar.Iletisim
@{
    ViewBag.Title = "İletişim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="contact-page">
    <div class="wrap">

        <div class="contact-header">
            <h3>İletişim</h3>
            <p>Bize mesaj bırakın, en kısa sürede dönüş sağlayalım.</p>
        </div>

        <div class="contact-layout">
            <div class="contact-form-col">
                @using (Html.BeginForm("Contact", "Home", FormMethod.Post))
                {
                    <div class="form-group">
                        <label>Ad Soyad</label>
                        <input type="text" name="AdSoyad" placeholder="Ad Soyad" required />
                    </div>
                    <div class="form-group">
                        <label>E-posta</label>
                        <input type="text" name="Mail" placeholder="ornek@mail.com" required />
                    </div>
                    <div class="form-group">
                        <label>Konu</label>
                        <input type="text" name="Konu" placeholder="Mesajınızın konusu" required />
                    </div>
                    <div class="form-group">
                        <label>Mesaj</label>
                        <textarea name="Mesaj" placeholder="Mesajınızı buraya yazın..." required></textarea>
                    </div>
                    <button type="submit" class="contact-submit">Gönder</button>
                }
            </div>
            <div class="contact-info-col">
                <div class="contact-info-card">
                    <div class="contact-info-icon">&#9993;</div>
                    <h4>Adres</h4>
                    <p>Mahalle, Sokak No:1<br>İstanbul / Türkiye</p>
                </div>
                <div class="contact-info-card">
                    <div class="contact-info-icon">&#9742;</div>
                    <h4>Telefon</h4>
                    <p>+90 212 000 00 00</p>
                </div>
                <div class="contact-info-card">
                    <div class="contact-info-icon">&#9993;</div>
                    <h4>E-posta</h4>
                    <p><a href="mailto:info@traveltrip.com">info@traveltrip.com</a></p>
                </div>
            </div>

        </div>
    </div>
</div>
