@{
    Layout = null;
}
@using TravelTrip.Models.Siniflar
@model List<Blog>
@using TravelTrip.Helper

<div class="blog-cards">
    @foreach (var i in Model.OrderByDescending(x => x.ID).Take(3))
    {
        <div class="blog-card">
            <div class="blog-card-img">
                <img src="@i.BlogImage" alt="@i.Baslik">
            </div>
            <div class="blog-card-body">
                <h4 class="blog-card-title">@i.Baslik</h4>
                <span class="blog-card-date">@i.Tarih.ToShortDateString()</span>
                <p class="blog-card-desc">
                    @if (i.Aciklama.Length > 70)
                    {
                        @i.Aciklama.KelimeBolmedenKisalt(70)<span>.....</span>
                    }
                    else
                    {
                        @i.Aciklama
                    }
                </p>
                <a href="/Blog/BlogDetay/@i.ID" class="blog-card-btn">Devamını Oku</a>
            </div>
        </div>
    }
</div>
